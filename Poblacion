# TABLA RESEÑAS
INSERT INTO resenas (id_resena, id_cliente, id_producto, calificacion, comentario, fecha_resena) VALUES
(1,  1,  1,  5, 'Un álbum increíble, los riffs son poderosos y la producción en vinyl es perfecta.',         '2020-02-25 10:00:00'),
(2,  2,  6,  5, 'La voz de Diana Cole es simplemente magistral. Un disco que no te puedes perder.',          '2020-06-01 11:30:00'),
(3,  3,  3,  4, 'Muy buen disco de reggae, con ritmos auténticos y letras con mensaje.',                     '2020-08-20 09:45:00'),
(4,  4,  7,  4, 'El grunge regresa con fuerza. Álbum oscuro e intenso.',                                    '2020-12-05 14:00:00'),
(5,  5,  5,  3, 'Cumbia clásica, buen entretenimiento aunque no innova demasiado.',                          '2021-02-14 12:30:00'),
(6,  6,  7,  5, 'Uno de los mejores álbumes de grunge de la última década. Muy recomendado.',                '2021-04-30 10:15:00'),
(7,  7,  13, 5, 'La música cubana en su mejor expresión. Noches de La Habana te transporta.',                '2021-07-10 13:00:00'),
(8,  8,  15, 4, 'Flamenco pop bien ejecutado. Sofía Benavides tiene un talento enorme.',                     '2021-08-25 09:30:00'),
(9,  9,  9,  5, 'Paris Neon es una obra maestra del synth-pop. El vinyl suena extraordinario.',              '2021-10-20 15:00:00'),
(10, 10, 10, 4, 'Rodrigo Palma nos entrega reflexiones profundas con melodías precisas.',                    '2022-01-05 11:00:00'),
(11, 11, 16, 5, 'Chicago After Midnight es jazz en su máxima expresión. Un regalo para los oídos.',          '2022-02-25 13:30:00'),
(12, 12, 12, 3, 'El trap está bien hecho pero esperaba más variedad en las letras.',                         '2022-05-03 10:45:00'),
(13, 13, 4,  5, 'Synthetic Horizons es el álbum electrónico del año. Producción impecable.',                 '2022-07-15 14:15:00'),
(14, 14, 6,  4, 'Soul Confessions tiene momentos brillantes. Diana Cole en su mejor forma.',                 '2022-09-10 09:00:00'),
(15, 15, 11, 4, 'Celtic Crossroads mezcla perfectamente la tradición irlandesa con el folk americano.',      '2022-10-28 12:00:00'),
(16, 16, 21, 3, 'Post-Punk Manifesto tiene energía pero las letras podrían ser más profundas.',              '2023-01-05 10:30:00'),
(17, 17, 18, 5, 'Northern Lights es una experiencia sonora única. Ambient en su máxima expresión.',         '2023-02-03 14:00:00'),
(18, 18, 18, 4, 'Un álbum muy atmosférico. Ideal para relajarse o concentrarse.',                           '2023-03-25 11:15:00'),
(19, 19, 22, 4, 'Groove Machine te hace mover los pies desde la primera pista.',                             '2023-06-08 09:30:00'),
(20, 20, 20, 5, 'La orquesta de Los Reyes del Mambo es simplemente fenomenal en este disco.',                '2023-08-01 13:45:00'),
(21, 21, 4,  5, 'Synthetic Horizons es innovador y envolvente. La electrónica alemana en su mejor versión.', '2023-09-20 10:00:00'),
(22, 22, 21, 4, 'Post-Punk Manifesto tiene momentos brillantes de energía pura.',                            '2023-11-05 11:30:00'),
(23, 23, 14, 5, 'Pillars of Steel es metal en estado puro. Producción brutal y técnica impecable.',          '2024-01-02 14:30:00'),
(24, 24, 24, 4, 'Progressive Storm dura mucho pero cada minuto vale la pena.',                               '2024-02-10 09:15:00'),
(25, 25, 7,  5, 'Wolves in the Static en vinyl es una experiencia que todo amante del grunge debe tener.',   '2024-03-28 12:00:00'),
(26, 26, 26, 4, 'Poemas del Domingo es indie rock con alma. Letras que te hacen pensar.',                    '2024-05-10 10:45:00'),
(27, 27, 5,  3, 'Cumbia entretenida, perfecta para una fiesta aunque sin mayor profundidad.',                '2024-06-22 13:00:00'),
(28, 28, 28, 4, 'Heaven Calling tiene una energía espiritual que te eriza la piel.',                         '2024-08-05 09:45:00'),
(29, 29, 15, 4, 'Flamenco Pop es fresco y moderno. Sofía Benavides sorprende gratamente.',                   '2024-09-20 14:00:00'),
(30, 30, 30, 5, 'Orbit One es perfecto. La música de Orbital Dreams trasciende géneros.',                    '2024-10-30 11:00:00');

